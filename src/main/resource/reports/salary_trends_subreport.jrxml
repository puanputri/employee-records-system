<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="SalaryTrendsSubreport" pageWidth="555" pageHeight="802">
    
    <!-- Parameters -->
    <parameter name="employeeId" class="java.lang.Integer"/>
    
    <!-- Fields -->
    <field name="year" class="java.lang.Integer"/>
    <field name="salary" class="java.math.BigDecimal"/>
    
    <!-- Query -->
    <queryString>
        <![CDATA[
            SELECT 
                EXTRACT(YEAR FROM start_date) AS year, 
                salary
            FROM 
                job_history
            WHERE 
                employee_id = $P{employeeId}
            ORDER BY 
                year ASC
        ]]>
    </queryString>
    
    <!-- Title -->
    <title>
        <band height="30">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Salary Growth Over Time]]></text>
            </staticText>
        </band>
    </title>
    
    <!-- Summary with Chart -->
    <summary>
        <band height="250">
            <lineChart>
                <chart evaluationTime="Report">
                    <reportElement x="0" y="0" width="555" height="250"/>
                    <chartTitle/>
                    <chartSubtitle/>
                    <chartLegend/>
                </chart>
                <categoryDataset>
                    <categorySeries>
                        <seriesExpression><![CDATA["Salary"]]></seriesExpression>
                        <categoryExpression><![CDATA[$F{year}]]></categoryExpression>
                        <valueExpression><![CDATA[$F{salary}]]></valueExpression>
                    </categorySeries>
                </categoryDataset>
                <linePlot>
                    <plot/>
                    <categoryAxisFormat>
                        <axisFormat labelColor="#000000" tickLabelColor="#000000" axisLineColor="#000000"/>
                    </categoryAxisFormat>
                    <valueAxisFormat>
                        <axisFormat labelColor="#000000" tickLabelColor="#000000" axisLineColor="#000000"/>
                    </valueAxisFormat>
                </linePlot>
            </lineChart>
        </band>
    </summary>
</jasperReport>
