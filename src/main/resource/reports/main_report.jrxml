<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="EmployeeReport" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    
    <!-- Parameters -->
    <parameter name="departmentParam" class="java.lang.String"/>
    <parameter name="startDateParam" class="java.util.Date"/>
    <parameter name="endDateParam" class="java.util.Date"/>
    <parameter name="SUBREPORT_DIR" class="java.lang.String"/>
    <parameter name="employeeId" class="java.lang.Integer"/>
    
    <!-- Fields -->
    <field name="id" class="java.lang.Integer"/>
    <field name="employeeId" class="java.lang.String"/>
    <field name="firstName" class="java.lang.String"/>
    <field name="lastName" class="java.lang.String"/>
    <field name="department" class="java.lang.String"/>
    <field name="currentSalary" class="java.math.BigDecimal"/>
    <field name="hireDate" class="java.util.Date"/>
    
    <!-- Style for high salary -->
    <style name="HighSalaryStyle">
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{currentSalary}.doubleValue() > 10000]]></conditionExpression>
            <style forecolor="#008000"/> <!-- Green -->
        </conditionalStyle>
    </style>
    
    <!-- Title -->
    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Employee Record Report]]></text>
            </staticText>
        </band>
    </title>
    
    <!-- Page Header -->
    <pageHeader>
        <band height="30">
            <textField pattern="MMMMM dd, yyyy">
                <reportElement x="455" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="355" y="0" width="100" height="20"/>
                <text><![CDATA[Report Date:]]></text>
            </staticText>
        </band>
    </pageHeader>
    
    <!-- Detail Section (Employee Personal Details) -->
    <detail>
        <band height="200">
            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[1. Employee Personal Details]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="30" width="100" height="20"/>
                <text><![CDATA[Employee ID:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="30" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{employeeId}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="50" width="100" height="20"/>
                <text><![CDATA[Name:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="50" width="200" height="20"/>
                <textFieldExpression><![CDATA[$F{firstName} + " " + $F{lastName}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="70" width="100" height="20"/>
                <text><![CDATA[Department:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="70" width="200" height="20"/>
                <textFieldExpression><![CDATA[$F{department}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="90" width="100" height="20"/>
                <text><![CDATA[Salary:]]></text>
            </staticText>
            <textField pattern="$#,##0.00">
                <reportElement x="100" y="90" width="200" height="20" style="HighSalaryStyle"/>
                <textFieldExpression><![CDATA[$F{currentSalary}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="110" width="100" height="20"/>
                <text><![CDATA[Hire Date:]]></text>
            </staticText>
            <textField pattern="MMMMM dd, yyyy">
                <reportElement x="100" y="110" width="200" height="20"/>
                <textFieldExpression><![CDATA[$F{hireDate}]]></textFieldExpression>
            </textField>
        </band>
        
        <!-- Job History Subreport -->
        <band height="250">
            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[2. Job History]]></text>
            </staticText>
            
            <subreport>
                <reportElement x="0" y="30" width="555" height="200"/>
                <subreportParameter name="employeeId">
                    <subreportParameterExpression><![CDATA[$F{id}]]></subreportParameterExpression>
                </subreportParameter>
                <connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
                <subreportExpression><![CDATA[$P{SUBREPORT_DIR} + "job_history_subreport.jasper"]]></subreportExpression>
            </subreport>
        </band>
        
        <!-- Performance Evaluations Subreport -->
        <band height="250">
            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[3. Performance Evaluations]]></text>
            </staticText>
            
            <subreport>
                <reportElement x="0" y="30" width="555" height="200"/>
                <subreportParameter name="employeeId">
                    <subreportParameterExpression><![CDATA[$F{id}]]></subreportParameterExpression>
                </subreportParameter>
                <connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
                <subreportExpression><![CDATA[$P{SUBREPORT_DIR} + "performance_evaluation_subreport.jasper"]]></subreportExpression>
            </subreport>
        </band>
        
        <!-- Salary Trends Subreport -->
        <band height="300">
            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[4. Salary Trends]]></text>
            </staticText>
            
            <subreport>
                <reportElement x="0" y="30" width="555" height="250"/>
                <subreportParameter name="employeeId">
                    <subreportParameterExpression><![CDATA[$F{id}]]></subreportParameterExpression>
                </subreportParameter>
                <connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
                <subreportExpression><![CDATA[$P{SUBREPORT_DIR} + "salary_trends_subreport.jasper"]]></subreportExpression>
            </subreport>
        </band>
    </detail>
    
    <!-- Summary (Company-wide Summary) -->
    <summary>
        <band height="200">
            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[5. Company-wide Summary]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="30" width="250" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Department]]></text>
            </staticText>
            <staticText>
                <reportElement x="250" y="30" width="100" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Employee Count]]></text>
            </staticText>
            
            <!-- This would be populated from a subreport or directly from a datasource query -->
            <subreport>
                <reportElement x="0" y="50" width="555" height="150"/>
                <connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
                <subreportExpression><![CDATA[$P{SUBREPORT_DIR} + "department_summary_subreport.jasper"]]></subreportExpression>
            </subreport>
        </band>
    </summary>
</jasperReport>
