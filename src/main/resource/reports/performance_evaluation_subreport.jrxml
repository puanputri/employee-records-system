<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="PerformanceEvaluationSubreport" pageWidth="555" pageHeight="802">
    
    <!-- Parameters -->
    <parameter name="employeeId" class="java.lang.Integer"/>
    
    <!-- Fields -->
    <field name="evaluationYear" class="java.lang.Integer"/>
    <field name="rating" class="java.math.BigDecimal"/>
    <field name="feedback" class="java.lang.String"/>
    <field name="evaluationDate" class="java.util.Date"/>
    
    <!-- Style for poor performance -->
    <style name="PoorPerformanceStyle">
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{rating}.doubleValue() < 3.0]]></conditionExpression>
            <style forecolor="#FF0000"/> <!-- Red -->
        </conditionalStyle>
    </style>
    
    <!-- Query -->
    <queryString>
        <![CDATA[
            SELECT 
                evaluation_year AS evaluationYear, 
                rating, 
                feedback, 
                evaluation_date AS evaluationDate
            FROM 
                performance_evaluations
            WHERE 
                employee_id = $P{employeeId}
            ORDER BY 
                evaluation_year DESC
        ]]>
    </queryString>
    
    <!-- Column Header -->
    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="50" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Year]]></text>
            </staticText>
            <staticText>
                <reportElement x="50" y="0" width="50" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Rating]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="0" width="355" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Feedback]]></text>
            </staticText>
            <staticText>
                <reportElement x="455" y="0" width="100" height="20"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Date]]></text>
            </staticText>
        </band>
    </columnHeader>
    
    <!-- Detail -->
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="50" height="20"/>
                <textFieldExpression><![CDATA[$F{evaluationYear}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.0">
                <reportElement x="50" y="0" width="50" height="20" style="PoorPerformanceStyle"/>
                <textFieldExpression><![CDATA[$F{rating}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="100" y="0" width="355" height="20"/>
                <textFieldExpression><![CDATA[$F{feedback}]]></textFieldExpression>
            </textField>
            <textField pattern="MMM dd, yyyy">
                <reportElement x="455" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{evaluationDate}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
