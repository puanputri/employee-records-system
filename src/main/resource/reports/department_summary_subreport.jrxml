<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="DepartmentSummarySubreport" pageWidth="555" pageHeight="802">
    
    <!-- Fields -->
    <field name="department" class="java.lang.String"/>
    <field name="employeeCount" class="java.lang.Long"/>
    
    <!-- Query -->
    <queryString>
        <![CDATA[
            SELECT 
                department, 
                COUNT(*) as employeeCount
            FROM 
                employees
            GROUP BY 
                department
            ORDER BY 
                department
        ]]>
    </queryString>
    
    <!-- Detail -->
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="250" height="20"/>
                <textFieldExpression><![CDATA[$F{department}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{employeeCount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <!-- Summary with Chart -->
    <summary>
        <band height="200">
            <pieChart>
                <chart evaluationTime="Report">
                    <reportElement x="0" y="0" width="555" height="200"/>
                    <chartTitle/>
                    <chartSubtitle/>
                    <chartLegend/>
                </chart>
                <pieDataset>
                    <keyExpression><![CDATA[$F{department}]]></keyExpression>
                    <valueExpression><![CDATA[$F{employeeCount}]]></valueExpression>
                    <labelExpression><![CDATA[$F{department} + " (" + $F{employeeCount} + ")"]]></labelExpression>
                </pieDataset>
                <piePlot>
                    <plot/>
                </piePlot>
            </pieChart>
        </band>
    </summary>
</jasperReport>
